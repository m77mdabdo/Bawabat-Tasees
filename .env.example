# Safe-by-default: this file documents PRODUCTION values, so an
# unreviewed copy never ships with debug output enabled. For local dev
# set APP_ENV=local and APP_DEBUG=true after copying to .env.
APP_NAME="بوابة تأسيس الشركات"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Trusted proxies (config/trustedproxy.php). Behind a TLS-terminating load
# balancer the original scheme only survives in X-Forwarded-Proto, which is
# ignored until the forwarding proxy is trusted — untrusted, HSTS is never
# sent and every generated URL says http on an https site.
#
# Empty (the default) trusts no proxy, in every environment: X-Forwarded-*
# headers are ignored, so nobody can forge the client IP or scheme. Behind a
# load balancer or reverse proxy, list its IPs/CIDRs, comma-separated, e.g.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10
# '*' trusts whichever machine connects directly; use it only when the
# application cannot be reached except through that proxy.
#
# Host header: outside local and testing, only APP_URL's host (and its
# subdomains) is accepted (bootstrap/app.php, trustHosts), so APP_URL must be
# the real public address, e.g. https://example.com.
TRUSTED_PROXIES=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Used by database/seeders/AdminUserSeeder to create the single dashboard admin user.
# REQUIRED outside local/testing — the seeder aborts rather than fall back to a
# placeholder credential, so these must hold real values before seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
# daily (not single) so production log files rotate instead of growing
# without bound.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Never send the session cookie over plain http. config/session.php
# already defaults this to true when APP_ENV=production; set it
# explicitly here so the intent is visible in every deployment.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real delivery needs SMTP (e.g. Hostinger: smtp.hostinger.com, port 465, MAIL_SCHEME=smtps).
# Production refuses to start with MAIL_MAILER=log or array (sign-in codes would never arrive,
# and "log" would write them to storage/logs/laravel.log). Use "log" only for local development.
# Check delivery with: php artisan mail:test you@example.com
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Enquiry alerts (recipients are managed in the dashboard: Enquiries → Enquiry email alerts).
# Language of the team's alert emails; the client always gets their own language.
NOTIFICATIONS_STAFF_LOCALE=ar
# Used only until a recipient is added in the dashboard (falls back to the site contact email).
NOTIFICATIONS_FALLBACK_ADDRESS=
# Send the client an automatic "we received your request" email.
NOTIFICATIONS_CONFIRM_TO_CLIENT=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
