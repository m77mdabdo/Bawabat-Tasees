# Safe-by-default: this file documents PRODUCTION values, so an
# unreviewed copy never ships with debug output enabled. For local dev
# set APP_ENV=local and APP_DEBUG=true after copying to .env.
APP_NAME="بوابة تأسيس الشركات"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Trusted proxies (config/trustedproxy.php). Behind a TLS-terminating load
# balancer the original scheme only survives in X-Forwarded-Proto, which is
# ignored until the forwarding proxy is trusted — untrusted, HSTS is never
# sent and every generated URL says http on an https site.
#
# Defaults to '*' in production (trust whatever proxy is directly in front
# of us, resolved to the calling IP — NOT "anybody"), and to nothing
# everywhere else. Set an explicit comma-separated list of load balancer
# IPs/CIDRs here if the application is also reachable directly.
# TRUSTED_PROXIES=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Used by database/seeders/AdminUserSeeder to create the single dashboard admin user.
# REQUIRED outside local/testing — the seeder aborts rather than fall back to a
# placeholder credential, so these must hold real values before seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
# daily (not single) so production log files rotate instead of growing
# without bound.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Never send the session cookie over plain http. config/session.php
# already defaults this to true when APP_ENV=production; set it
# explicitly here so the intent is visible in every deployment.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
